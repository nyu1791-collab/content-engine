GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# WordPress（ユーザー > プロフィール > アプリケーションパスワード）
WP_URL=https://your-blog.com
WP_USER=
WP_APP_PASSWORD=
WP_CATEGORY_ID=
# X Developer（Read and Write 権限で発行）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Firecrawl ローカル（./scripts/firecrawl.ps1 up 後）。クラウドを使うなら FIRECRAWL_API_KEY
FIRECRAWL_API_URL=
# browser-use
BROWSER_USE_MODEL=
ANONYMIZED_TELEMETRY=false
BROWSER_USE_SETUP_LOGGING=true
